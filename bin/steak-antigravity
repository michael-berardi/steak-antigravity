#!/usr/bin/env python3
"""Steak Antigravity CLI: doctor, install, uninstall, status, update, identity, version."""
from __future__ import annotations

import json
import os
import shlex
import shutil
import sys
import time
from pathlib import Path

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))
import auto_resume  # noqa: E402
import update_check  # noqa: E402
import ut_common  # noqa: E402

GEMINI_CONFIG = Path.home() / ".gemini/config"
AGY_SETTINGS = Path.home() / ".gemini/antigravity-cli/settings.json"
STATUSLINE_SCRIPT_NAME = "antigravity_statusline.py"


def statusline_command() -> str:
    return f"python3 -I -B {shlex.quote(str(ROOT / 'scripts' / STATUSLINE_SCRIPT_NAME))}"


def _write_private_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    tmp = path.parent / f".{path.name}.{os.getpid()}.{time.time_ns()}.tmp"
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(tmp, flags, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(json.dumps(data, indent=2) + "\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp, path)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def configure_statusline(settings_path: Path = AGY_SETTINGS) -> bool:
    """Wire Antigravity's official statusLine command unless a third-party one is set."""
    data: dict = {}
    if settings_path.exists() or settings_path.is_symlink():
        if settings_path.is_symlink() or not settings_path.is_file():
            return False
        try:
            parsed = json.loads(settings_path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            return False
        if not isinstance(parsed, dict):
            return False
        data = parsed
    if "statusLine" in data:
        existing = data["statusLine"]
        if not isinstance(existing, dict):
            return False
        cmd = str(existing.get("command") or "")
        if cmd and STATUSLINE_SCRIPT_NAME not in cmd:
            return False
    data["statusLine"] = {
        "command": statusline_command(),
        "stack_with_default": True,
    }
    try:
        _write_private_json(settings_path, data)
    except OSError:
        return False
    return True


def remove_statusline(settings_path: Path = AGY_SETTINGS) -> bool:
    if not settings_path.is_file():
        return False
    try:
        data = json.loads(settings_path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return False
    if not isinstance(data, dict):
        return False
    existing = data.get("statusLine")
    if isinstance(existing, dict) and STATUSLINE_SCRIPT_NAME in str(existing.get("command") or ""):
        del data["statusLine"]
        _write_private_json(settings_path, data)
        return True
    return False


def statusline_configured(settings_path: Path = AGY_SETTINGS) -> bool:
    if not settings_path.is_file():
        return False
    try:
        data = json.loads(settings_path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return False
    existing = data.get("statusLine") if isinstance(data, dict) else None
    return isinstance(existing, dict) and STATUSLINE_SCRIPT_NAME in str(existing.get("command") or "")


def version() -> str:
    pkg_path = ROOT / "package.json"
    try:
        parsed = json.loads(pkg_path.read_text())
    except (OSError, ValueError) as exc:
        raise RuntimeError(f"steak-antigravity: cannot read version from {pkg_path}: {exc}") from exc
    ver = parsed.get("version") if isinstance(parsed, dict) else None
    if not isinstance(ver, str) or not ver.strip():
        raise RuntimeError(f"steak-antigravity: missing valid version in {pkg_path}")
    return ver.strip()


class ConfigError(RuntimeError):
    pass


def read_entries_config(config_path: Path) -> dict:
    """Read an Antigravity {"entries": [...]} config; refuse (never overwrite) one we cannot parse."""
    if not config_path.exists():
        return {"entries": []}
    try:
        raw = config_path.read_text(encoding="utf-8")
    except OSError as exc:
        raise ConfigError(f"cannot read {config_path}: {exc}") from exc
    if not raw.strip():
        return {"entries": []}
    try:
        parsed = json.loads(raw)
    except ValueError as exc:
        raise ConfigError(f"{config_path} is not valid JSON ({exc}); fix or remove it, nothing was changed") from exc
    if not isinstance(parsed, dict) or not isinstance(parsed.get("entries", []), list):
        raise ConfigError(f"{config_path} must be an object with an \"entries\" list; nothing was changed")
    parsed.setdefault("entries", [])
    return parsed


def write_entries_config(config_path: Path, data: dict) -> None:
    path = config_path
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.parent / f".{path.name}.{os.getpid()}.{time.time_ns()}.tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o644)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(json.dumps(data, indent=2) + "\n")
        os.replace(tmp, path)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def upsert_json_entry(config_path: Path, entry_path: str) -> None:
    """Add an absolute path entry; Antigravity rejects `~` paths in skills.json/plugins.json."""
    absolute = str(Path(entry_path).expanduser())
    data = read_entries_config(config_path)
    entries = [
        e
        for e in data["entries"]
        # Migrate entries this tool wrote in older versions with a literal `~`.
        if not (isinstance(e, dict) and isinstance(e.get("path"), str) and e["path"].startswith("~")
                and str(Path(e["path"]).expanduser()) == absolute)
    ]
    if not any(isinstance(e, dict) and e.get("path") == absolute for e in entries):
        entries.append({"path": absolute})
    data["entries"] = entries
    write_entries_config(config_path, data)


def relative_config_paths(config_path: Path) -> list[str]:
    try:
        data = read_entries_config(config_path)
    except ConfigError:
        return []
    return [
        e["path"]
        for e in data["entries"]
        if isinstance(e, dict) and isinstance(e.get("path"), str) and not e["path"].startswith("/")
    ]


LEGACY_MCP_CACHE_NAMES = ("steak-agy_usap",)


def remove_legacy_mcp_cache(cache_root: Path = Path.home() / ".gemini/antigravity-cli/mcp") -> list[str]:
    """Drop the cached tool schemas of the plugin's pre-rename server name (steak-agy)."""
    removed = []
    for name in LEGACY_MCP_CACHE_NAMES:
        target = cache_root / name
        if target.is_dir() and not target.is_symlink():
            shutil.rmtree(target)
            removed.append(str(target))
    return removed


def cmd_install() -> int:
    try:
        return _install()
    except ConfigError as exc:
        print(f"steak-antigravity install: ConfigError: {exc}", file=sys.stderr)
        return 1


def _cli_bin_dir() -> Path:
    raw = os.environ.get("STEAK_ANTIGRAVITY_BIN_DIR", "").strip()
    if raw:
        return Path(raw).expanduser()
    return Path.home() / ".local/bin"


def _symlink_points_to_self(link: Path) -> bool:
    target = ROOT / "bin/steak-antigravity"
    try:
        raw_target = os.readlink(link)
    except OSError:
        return False
    if raw_target == str(target):
        return True
    try:
        return link.resolve() == target.resolve()
    except OSError:
        return False


def _install_cli_link(local_bin: Path) -> None:
    if os.environ.get("STEAK_ANTIGRAVITY_SKIP_BIN_LINK") == "1":
        return
    local_bin.mkdir(parents=True, exist_ok=True)
    link = local_bin / "steak-antigravity"
    if not (link.is_symlink() or not link.exists()):
        return
    target = ROOT / "bin/steak-antigravity"
    tmp_link = local_bin / f".steak-antigravity.{os.getpid()}.{time.time_ns()}.tmp"
    try:
        tmp_link.symlink_to(target)
        os.replace(tmp_link, link)
    except OSError:
        try:
            tmp_link.unlink()
        except OSError:
            pass
        if os.name != "nt":
            raise


def _install() -> int:
    # Register plugin directory via plugins.json (parent directory containing steak-antigravity).
    # Note: plugins.json scans entries one level deep, so register the parent directory
    # with include_only: ["steak-antigravity"] to avoid picking up unrelated siblings.
    plugins_json = GEMINI_CONFIG / "plugins.json"
    data = read_entries_config(plugins_json)
    skills_json = GEMINI_CONFIG / "skills.json"
    if ut_common.SHARED_SKILLS.is_dir():
        read_entries_config(skills_json)  # validate before changing anything
    entries = data["entries"]
    parent = str(ROOT.parent)
    name = ROOT.name
    existing = next(
        (e for e in entries if isinstance(e, dict) and e.get("path") == parent and e.get("include_only") == [name]),
        None,
    )
    if not existing:
        entries.append({"path": parent, "include_only": [name]})
    write_entries_config(plugins_json, data)

    # Wire shared UltraTerm/agent skills if present (absolute path: agy rejects `~`).
    if ut_common.SHARED_SKILLS.is_dir():
        upsert_json_entry(skills_json, str(ut_common.SHARED_SKILLS))

    for path in remove_legacy_mcp_cache():
        print(f"removed stale MCP cache {path}")

    # Wire official Antigravity statusLine snapshot writer (non-destructive).
    configure_statusline()

    # Install CLI shim in STEAK_ANTIGRAVITY_BIN_DIR (default ~/.local/bin).
    _install_cli_link(_cli_bin_dir())

    print(f"steak-antigravity {version()} installed into {GEMINI_CONFIG}")
    return 0


def cmd_uninstall() -> int:
    plugins_json = GEMINI_CONFIG / "plugins.json"
    if plugins_json.is_file():
        try:
            data = read_entries_config(plugins_json)
        except ConfigError as exc:
            print(f"steak-antigravity uninstall: ConfigError: {exc}", file=sys.stderr)
            return 1
        data["entries"] = [
            e
            for e in data["entries"]
            if not (
                isinstance(e, dict)
                and e.get("path") == str(ROOT.parent)
                and e.get("include_only") == [ROOT.name]
            )
        ]
        write_entries_config(plugins_json, data)
    remove_statusline()
    update_check.forget()
    local_bin = _cli_bin_dir()
    link = local_bin / "steak-antigravity"
    if link.is_symlink() and _symlink_points_to_self(link):
        link.unlink()
    print(f"steak-antigravity removed from {plugins_json} and {local_bin}")
    return 0


def cmd_doctor() -> int:
    identity = ut_common.terminal_identity()
    checks = {
        "version": version(),
        "pluginRoot": str(ROOT),
        "agyBinary": shutil.which("agy"),
        "nodeBinary": shutil.which("node"),
        "piSdk": str(ut_common.pi_sdk_entry()) if ut_common.pi_sdk_entry() else None,
        "steakPiRoot": str(ut_common.steak_pi_root()) if ut_common.steak_pi_root() else None,
        "utpBinary": str(ut_common.UTP) if os.access(ut_common.UTP, os.X_OK) else None,
        "retexBinary": ut_common.retex_binary(),
        "sharedAgentsMd": (ut_common.PI_AGENT_DIR / "AGENTS.md").is_file(),
        "sharedSkillsDir": ut_common.SHARED_SKILLS.is_dir(),
        "pluginsJsonConfigured": (GEMINI_CONFIG / "plugins.json").is_file(),
        "skillsJsonConfigured": (GEMINI_CONFIG / "skills.json").is_file(),
        "skillsJsonRelativePaths": relative_config_paths(GEMINI_CONFIG / "skills.json"),
        "legacyMcpCache": [
            name for name in LEGACY_MCP_CACHE_NAMES
            if (Path.home() / ".gemini/antigravity-cli/mcp" / name).is_dir()
        ],
        "statusLineConfigured": statusline_configured(),
        "usageSnapshotPresent": (Path.home() / ".ultraterm/antigravity/usage.json").is_file(),
        "uiTranscriptEnv": bool(os.environ.get("ULTRATERM_UI_TRANSCRIPT_FILE")),
        "autoResume": auto_resume.doctor_summary(identity=identity),
        "updates": update_check.status_summary(ROOT),
        "identity": identity,
    }
    print(json.dumps(checks, indent=2))
    problems = []
    if checks["skillsJsonRelativePaths"]:
        problems.append(
            f"skills.json has non-absolute paths Antigravity rejects: {checks['skillsJsonRelativePaths']} "
            "(run `steak-antigravity install`)"
        )
    if checks["legacyMcpCache"]:
        problems.append(f"stale MCP cache from the old plugin name: {checks['legacyMcpCache']} (run `steak-antigravity install`)")
    for problem in problems:
        print(f"steak-antigravity doctor: {problem}", file=sys.stderr)
    ok = bool(checks["nodeBinary"] and checks["piSdk"] and checks["steakPiRoot"] and checks["pluginsJsonConfigured"])
    return 0 if ok and not problems else 1


def cmd_update(args: list[str]) -> int:
    return update_check.command(args, ROOT)


def cmd_auto_resume(args: list[str]) -> int:
    sub = args[0] if args else "status"
    if sub == "status":
        print(json.dumps(auto_resume.doctor_summary(), indent=2))
        return 0
    if sub == "cancel":
        if len(args) > 1 and args[1].strip():
            conv_id = args[1].strip()
            cancelled = auto_resume.cancel_for_conversation(conv_id, reason="operator_cancel", reset_attempts=True)
            print(json.dumps({"cancelled": 1 if cancelled else 0, "conversationId": conv_id}, indent=2))
            return 0
        count = auto_resume.cancel_all(reason="operator_cancel")
        print(json.dumps({"cancelled": count}, indent=2))
        return 0
    print("Usage: steak-antigravity auto-resume [status|cancel [conversationId]]", file=sys.stderr)
    return 2


def run(cmd: str, args: list[str]) -> int:
    if cmd in ("-v", "--version", "version"):
        print(version())
        return 0
    if cmd == "install":
        return cmd_install()
    if cmd == "uninstall":
        return cmd_uninstall()
    if cmd in ("doctor", "status"):
        return cmd_doctor()
    if cmd == "auto-resume":
        return cmd_auto_resume(args)
    if cmd == "update":
        return cmd_update(args)
    if cmd == "identity":
        print(json.dumps(ut_common.terminal_identity(), indent=2))
        return 0
    print(
        "Usage: steak-antigravity <doctor|status|auto-resume|update|install|uninstall|identity|version>",
        file=sys.stderr,
    )
    return 2


def main() -> None:
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    code = run(cmd, sys.argv[2:])
    if cmd not in ("install", "uninstall", "update"):
        try:
            update_check.after_command(ROOT)
        except Exception:
            pass  # an update notice must never change a command's result
    sys.exit(code)


if __name__ == "__main__":
    main()
