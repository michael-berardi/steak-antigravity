#!/usr/bin/env python3
"""Steak Antigravity CLI: doctor, install, uninstall, status, identity, version."""
from __future__ import annotations

import json
import os
import shlex
import shutil
import sys
import time
from pathlib import Path

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))
import ut_common  # noqa: E402

GEMINI_CONFIG = Path.home() / ".gemini/config"
AGY_SETTINGS = Path.home() / ".gemini/antigravity-cli/settings.json"
STATUSLINE_SCRIPT_NAME = "antigravity_statusline.py"


def statusline_command() -> str:
    return f"python3 -I -B {shlex.quote(str(ROOT / 'scripts' / STATUSLINE_SCRIPT_NAME))}"


def _write_private_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    tmp = path.parent / f".{path.name}.{os.getpid()}.{time.time_ns()}.tmp"
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(tmp, flags, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(json.dumps(data, indent=2) + "\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp, path)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def configure_statusline(settings_path: Path = AGY_SETTINGS) -> bool:
    """Wire Antigravity's official statusLine command unless a third-party one is set."""
    data: dict = {}
    if settings_path.exists() or settings_path.is_symlink():
        if settings_path.is_symlink() or not settings_path.is_file():
            return False
        try:
            parsed = json.loads(settings_path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            return False
        if not isinstance(parsed, dict):
            return False
        data = parsed
    if "statusLine" in data:
        existing = data["statusLine"]
        if not isinstance(existing, dict):
            return False
        cmd = str(existing.get("command") or "")
        if cmd and STATUSLINE_SCRIPT_NAME not in cmd:
            return False
    data["statusLine"] = {
        "command": statusline_command(),
        "stack_with_default": True,
    }
    try:
        _write_private_json(settings_path, data)
    except OSError:
        return False
    return True


def remove_statusline(settings_path: Path = AGY_SETTINGS) -> bool:
    if not settings_path.is_file():
        return False
    try:
        data = json.loads(settings_path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return False
    if not isinstance(data, dict):
        return False
    existing = data.get("statusLine")
    if isinstance(existing, dict) and STATUSLINE_SCRIPT_NAME in str(existing.get("command") or ""):
        del data["statusLine"]
        _write_private_json(settings_path, data)
        return True
    return False


def statusline_configured(settings_path: Path = AGY_SETTINGS) -> bool:
    if not settings_path.is_file():
        return False
    try:
        data = json.loads(settings_path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return False
    existing = data.get("statusLine") if isinstance(data, dict) else None
    return isinstance(existing, dict) and STATUSLINE_SCRIPT_NAME in str(existing.get("command") or "")


def version() -> str:
    pkg_path = ROOT / "package.json"
    try:
        parsed = json.loads(pkg_path.read_text())
    except (OSError, ValueError) as exc:
        raise RuntimeError(f"steak-antigravity: cannot read version from {pkg_path}: {exc}") from exc
    ver = parsed.get("version") if isinstance(parsed, dict) else None
    if not isinstance(ver, str) or not ver.strip():
        raise RuntimeError(f"steak-antigravity: missing valid version in {pkg_path}")
    return ver.strip()


def upsert_json_entry(config_path: Path, entry_path: str) -> None:
    data: dict = {"entries": []}
    if config_path.is_file():
        try:
            parsed = json.loads(config_path.read_text())
            if isinstance(parsed, dict):
                data = parsed
        except (OSError, ValueError):
            pass
    entries = data.setdefault("entries", [])
    if not any(isinstance(e, dict) and e.get("path") == entry_path for e in entries):
        entries.append({"path": entry_path})
    config_path.parent.mkdir(parents=True, exist_ok=True)
    config_path.write_text(json.dumps(data, indent=2) + "\n")


def cmd_install() -> int:
    # Register plugin directory via plugins.json (parent directory containing steak-antigravity).
    # Note: plugins.json scans entries one level deep, so register the parent directory
    # with include_only: ["steak-antigravity"] to avoid picking up unrelated siblings.
    plugins_json = GEMINI_CONFIG / "plugins.json"
    data: dict = {"entries": []}
    if plugins_json.is_file():
        try:
            parsed = json.loads(plugins_json.read_text())
            if isinstance(parsed, dict):
                data = parsed
        except (OSError, ValueError):
            pass
    entries = data.setdefault("entries", [])
    parent = str(ROOT.parent)
    name = ROOT.name
    existing = next(
        (e for e in entries if isinstance(e, dict) and e.get("path") == parent and e.get("include_only") == [name]),
        None,
    )
    if not existing:
        entries.append({"path": parent, "include_only": [name]})
    plugins_json.parent.mkdir(parents=True, exist_ok=True)
    plugins_json.write_text(json.dumps(data, indent=2) + "\n")

    # Wire shared UltraTerm/agent skills if present.
    if ut_common.SHARED_SKILLS.is_dir():
        upsert_json_entry(GEMINI_CONFIG / "skills.json", "~/.config/agents/skills")

    # Wire official Antigravity statusLine snapshot writer (non-destructive).
    configure_statusline()

    # Install CLI shim in ~/.local/bin.
    local_bin = Path.home() / ".local/bin"
    local_bin.mkdir(parents=True, exist_ok=True)
    link = local_bin / "steak-antigravity"
    if link.is_symlink() or not link.exists():
        if link.is_symlink():
            link.unlink()
        link.symlink_to(ROOT / "bin/steak-antigravity")

    print(f"steak-antigravity {version()} installed into {GEMINI_CONFIG}")
    return 0


def cmd_uninstall() -> int:
    plugins_json = GEMINI_CONFIG / "plugins.json"
    if plugins_json.is_file():
        try:
            data = json.loads(plugins_json.read_text())
            entries = [
                e
                for e in data.get("entries", [])
                if not (isinstance(e, dict) and e.get("include_only") == [ROOT.name])
            ]
            data["entries"] = entries
            plugins_json.write_text(json.dumps(data, indent=2) + "\n")
        except (OSError, ValueError):
            pass
    remove_statusline()
    link = Path.home() / ".local/bin/steak-antigravity"
    if link.is_symlink():
        link.unlink()
    print("steak-antigravity removed from ~/.gemini/config/plugins.json and ~/.local/bin")
    return 0


def cmd_doctor() -> int:
    checks = {
        "version": version(),
        "pluginRoot": str(ROOT),
        "agyBinary": shutil.which("agy"),
        "nodeBinary": shutil.which("node"),
        "piSdk": str(ut_common.pi_sdk_entry()) if ut_common.pi_sdk_entry() else None,
        "steakPiRoot": str(ut_common.steak_pi_root()) if ut_common.steak_pi_root() else None,
        "utpBinary": str(ut_common.UTP) if os.access(ut_common.UTP, os.X_OK) else None,
        "retexBinary": ut_common.retex_binary(),
        "sharedAgentsMd": (ut_common.PI_AGENT_DIR / "AGENTS.md").is_file(),
        "sharedSkillsDir": ut_common.SHARED_SKILLS.is_dir(),
        "pluginsJsonConfigured": (GEMINI_CONFIG / "plugins.json").is_file(),
        "skillsJsonConfigured": (GEMINI_CONFIG / "skills.json").is_file(),
        "statusLineConfigured": statusline_configured(),
        "usageSnapshotPresent": (Path.home() / ".ultraterm/antigravity/usage.json").is_file(),
        "uiTranscriptEnv": bool(os.environ.get("ULTRATERM_UI_TRANSCRIPT_FILE")),
        "identity": ut_common.terminal_identity(),
    }
    print(json.dumps(checks, indent=2))
    ok = bool(checks["nodeBinary"] and checks["piSdk"] and checks["steakPiRoot"] and checks["pluginsJsonConfigured"])
    return 0 if ok else 1


def main() -> None:
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd in ("-v", "--version", "version"):
        print(version())
        sys.exit(0)
    if cmd == "install":
        sys.exit(cmd_install())
    if cmd == "uninstall":
        sys.exit(cmd_uninstall())
    if cmd in ("doctor", "status"):
        sys.exit(cmd_doctor())
    if cmd == "identity":
        print(json.dumps(ut_common.terminal_identity(), indent=2))
        sys.exit(0)
    print("Usage: steak-antigravity <doctor|status|install|uninstall|identity|version>", file=sys.stderr)
    sys.exit(2)


if __name__ == "__main__":
    main()
