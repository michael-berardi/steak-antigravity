{
  "steak-agy-session": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 -I -B \"${PLUGIN_ROOT:?steak-agy: PLUGIN_ROOT unset}/scripts/session_start.py\"",
        "timeout": 15
      }
    ]
  },
  "steak-agy-transcript": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 -I -B \"${PLUGIN_ROOT:?steak-agy: PLUGIN_ROOT unset}/scripts/ui_transcript_sync.py\" --event pre-invocation",
        "timeout": 10
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "python3 -I -B \"${PLUGIN_ROOT:?steak-agy: PLUGIN_ROOT unset}/scripts/ui_transcript_sync.py\" --event post-invocation",
        "timeout": 10
      }
    ]
  },
  "steak-agy-guards": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"${PLUGIN_ROOT:?steak-agy: PLUGIN_ROOT unset}/scripts/owned_paths_guard.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"${PLUGIN_ROOT:?steak-agy: PLUGIN_ROOT unset}/scripts/delegation_guard.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "steak-agy-verify": {
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"${PLUGIN_ROOT:?steak-agy: PLUGIN_ROOT unset}/scripts/verify_after_edit.py\"",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"${PLUGIN_ROOT:?steak-agy: PLUGIN_ROOT unset}/scripts/ui_transcript_sync.py\" --event post-tool",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "steak-agy-stop": {
    "Stop": [
      {
        "type": "command",
        "command": "python3 -I -B \"${PLUGIN_ROOT:?steak-agy: PLUGIN_ROOT unset}/scripts/stop_hook.py\"",
        "timeout": 15
      }
    ]
  }
}
